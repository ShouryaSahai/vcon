# =============================================================================
# Vcon — environment template. Copy to .env.local and fill in.
# .env.local is git-ignored; never commit real keys.
# =============================================================================

# Supabase — Project Settings → API
# New projects issue sb_publishable_ / sb_secret_ keys; use publishable as the
# anon key below and secret as the service-role key. A local `supabase start`
# stack prints its own pair via `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY. Bypasses RLS. Never expose to the
# client, never prefix with NEXT_PUBLIC_. Used only by trusted server ops (M8).
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (used from M6 onward, server-side only)
GEMINI_API_KEY=
# OPENROUTER_API_KEY= (added later, behind the same provider interface)

# Judge/demo fast path (optional). When BOTH are set, the login screen shows a
# one-click "Try the demo" card with these credentials. Values are public by
# design — use a demo-only account with demo data, never a real user.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

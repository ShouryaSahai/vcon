# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets and local environment files: never commit real values.
# The only intentionally tracked env file is the blank template.
.env*
!.env.example

# workspace-local tooling (pnpm store / redirected caches)
/.pnpm-store
/.cache
/.home

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
